# Initial dashboard login. You'll be asked to change the password on first
# sign-in; after that it's stored (hashed) in the data volume and these are ignored.
# Leave PADDOCK_PASSWORD empty to have one generated and printed to the container log.
PADDOCK_USERNAME=admin
PADDOCK_PASSWORD=change-me

# Disable the login entirely, e.g. when Traefik/Authelia already sits in front of it.
# PADDOCK_AUTH=off

# Behind a reverse proxy, the number of proxies in front of the dashboard, so the
# login lockout can tell clients apart (see docs/security.md).
# PADDOCK_TRUSTED_PROXIES=1

# Scrape token for Prometheus /metrics, which is off without one (see docs/prometheus.md).
# PADDOCK_METRICS_TOKEN=

# Agent tokens for hosts defined in config.yaml (hosts added in the UI store their own).
# OLLAMA01_AGENT_TOKEN=
