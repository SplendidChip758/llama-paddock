# Agent tokens (printed by agent/install.sh on each Ollama host)
OLLAMA01_AGENT_TOKEN=change-me
OLLAMA02_AGENT_TOKEN=change-me

# Dashboard login (HTTP basic auth). Leave both empty to disable,
# e.g. when Traefik/Authelia already sits in front of it.
PADDOCK_USERNAME=admin
PADDOCK_PASSWORD=change-me
